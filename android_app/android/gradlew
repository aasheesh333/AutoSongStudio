#!/usr/bin/env sh
# -------------------------------------------------------
# Gradle Wrapper script generated by Gradle.
# -------------------------------------------------------

# This script is used to invoke the Gradle build tool.
# It will download the Gradle distribution if not already present.

# Resolve the location of the script.
APP_HOME="${0%/*}"

# Resolve the location of the Gradle wrapper properties.
GRADLE_WRAPPER_PROPERTIES="${APP_HOME}/gradle/wrapper/gradle-wrapper.properties"

# Read the distribution URL from the properties file.
DISTRIBUTION_URL=$(grep distributionUrl "$GRADLE_WRAPPER_PROPERTIES" | cut -d= -f2-)

# Determine the Gradle user home directory.
GRADLE_USER_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}"

# Determine the location where the Gradle distribution will be stored.
GRADLE_DIST_DIR="$GRADLE_USER_HOME/wrapper/dists"

# Build the path to the distribution zip.
ZIP_NAME=$(basename "$DISTRIBUTION_URL")
ZIP_PATH="$GRADLE_DIST_DIR/$ZIP_NAME"

# Download the distribution if it does not exist.
if [ ! -f "$ZIP_PATH" ]; then
  echo "Downloading Gradle distribution..."
  mkdir -p "$GRADLE_DIST_DIR"
  curl -L "$DISTRIBUTION_URL" -o "$ZIP_PATH"
fi

# Unzip the distribution.
UNZIP_DIR="$GRADLE_DIST_DIR/${ZIP_NAME%.*}"
if [ ! -d "$UNZIP_DIR" ]; then
  echo "Unzipping Gradle distribution..."
  unzip -q "$ZIP_PATH" -d "$UNZIP_DIR"
fi

# Execute Gradle.
exec "$UNZIP_DIR/gradle-${DISTRIBUTION_URL##*/}" "$@"
