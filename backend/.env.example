# Server Configuration
NODE_ENV=production
PORT=3000
BASE_URL=https://jusdown.onrender.com

# Firebase Configuration
FIREBASE_JSON_BASE64=<base64_encoded_service_account_json>

# API Keys
LLAMA_API_KEY=<groq_api_key>
LLAMA_API_URL=https://api.groq.com/openai/v1/chat/completions
HF_TOKEN=<huggingface_token>
SUNO_API_KEY=<suno_api_key>

# Suno API Configuration
SUNO_BASE_URL=https://api.sunoapi.org

# YouTube OAuth 2.0
GOOGLE_CLIENT_ID=<google_oauth_client_id>
GOOGLE_CLIENT_SECRET=<google_oauth_client_secret>

# Plan & Security
PLAN_SIGN_SECRET=<secret_for_plan_signing>

# Redis (for job queue) - Render.com auto-provisions
REDIS_URL=<redis_connection_url>

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=60
MAX_GENERATION_PER_DAY=6
